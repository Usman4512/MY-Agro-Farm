# ============================================================
#  AGRO SYSTEM — Railway Environment Variables
#  Copy these into Railway → Your Service → Variables tab
# ============================================================

# Flask Secret Key (generate a random string)
SECRET_KEY=replace-with-long-random-string-here

# MySQL Database (Railway will auto-provide these if you add MySQL plugin)
# After adding MySQL plugin in Railway, it auto-sets MYSQLDATABASE, MYSQLHOST, etc.
# But your app reads these variable names — so copy from Railway plugin values:
MYSQL_HOST=your-railway-mysql-host        # from Railway MySQL plugin
MYSQL_USER=root                           # from Railway MySQL plugin
MYSQL_PASSWORD=your-railway-mysql-password
MYSQL_DB=railway                          # or agrosystem — your DB name
MYSQL_PORT=3306

# Gmail SMTP — use Gmail App Password (NOT your normal password)
# To get App Password: Google Account → Security → 2-Step Verification → App passwords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx         # 16-char Gmail App Password (no spaces)
MAIL_DEFAULT_SENDER=Agro System <your-email@gmail.com>

# Admin account email
ADMIN_EMAIL=your-email@gmail.com

# Your payment numbers (Pakistan)
JAZZCASH_NUMBER=03001234567
EASYPAISA_NUMBER=03001234567
OWNER_NAME=Your Full Name
